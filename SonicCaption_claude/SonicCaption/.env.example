# Copy to .env and fill in. Nothing here is required to start the app.

# Speech-to-text. With a key, audio is sent to Groq's hosted Whisper (fast, free tier at console.groq.com).
# Without a key the app uses faster-whisper on your own machine (nothing leaves it, ~150 MB model downloaded on first use).
GROQ_API_KEY=

# Optional tuning
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# FASTER_WHISPER_MODEL=base          # tiny | base | small | medium  (bigger = more accurate, slower)
# SONICCAPTION_MAX_UPLOAD_MB=200
# SONICCAPTION_DB_PATH=backend/data/soniccaption.db
